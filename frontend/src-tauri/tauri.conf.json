{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PULSO",
  "version": "0.1.0",
  "identifier": "com.paywin.pulso",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PULSO — Operador",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/generated/icon.ico",
      "icons/generated/icon.png"
    ],
    "externalBin": [
      "binaries/pulso-engine"
    ],
    "resources": {
      "../../models/vosk-model-small-pt-0.3/": "models/vosk-model-small-pt-0.3/"
    }
  }
}
